# Database Configuration (SQLite for zero-config local, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PhonePe Standard Checkout V2 Configuration
PHONEPE_ENV="SANDBOX" # SANDBOX or PRODUCTION
PHONEPE_CLIENT_ID="your-phonepe-client-id"
PHONEPE_CLIENT_SECRET="your-phonepe-client-secret"
PHONEPE_CLIENT_VERSION="1"
# Temporary server-only sanitized request/response diagnostics; disable after investigation.
PHONEPE_DIAGNOSTICS="false"
PHONEPE_MERCHANT_ID="your-phonepe-merchant-id"
APP_BASE_URL="http://localhost:3000"
PHONEPE_WEBHOOK_AUTH_MODE="SHA" # HMAC is rejected pending verified provider test vectors
PHONEPE_WEBHOOK_USERNAME="" # Set to the username configured in PhonePe dashboard
PHONEPE_WEBHOOK_PASSWORD="" # Set a strong password matching PhonePe dashboard

# Contact & Notifications
SUPPORT_EMAIL="support@genzlivingspace.com"
SUPPORT_PHONE="+91 98765 43210"

# Google OAuth 2.0 Credentials (Get from console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Dev Admin Master Key (Exclusive to developer; isolated from client/Super Admin)
DEV_ADMIN_KEY="genz_dev_master_2026"

# Required for /api/cron/reconcile-payments; schedule with Authorization: Bearer <secret>.
CRON_SECRET=""
