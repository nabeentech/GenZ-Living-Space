# Database Configuration (SQLite for zero-config local, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PhonePe Standard Checkout V2 Configuration
PHONEPE_ENV="SANDBOX" # SANDBOX or PRODUCTION
PHONEPE_CLIENT_ID="your-phonepe-client-id"
PHONEPE_CLIENT_SECRET="your-phonepe-client-secret"
PHONEPE_CLIENT_VERSION="1"
PHONEPE_MERCHANT_ID="your-phonepe-merchant-id"
APP_BASE_URL="http://localhost:3000"
PHONEPE_WEBHOOK_AUTH_MODE="SHA" # SHA or HMAC
PHONEPE_WEBHOOK_USERNAME="genz_webhook_user"
PHONEPE_WEBHOOK_PASSWORD="genz_webhook_password"
PHONEPE_WEBHOOK_KEY_ID="your-hmac-key-id"
PHONEPE_WEBHOOK_SECRET="your-hmac-secret"

# Contact & Notifications
SUPPORT_EMAIL="support@genzlivingspace.com"
SUPPORT_PHONE="+91 98765 43210"

# Google OAuth 2.0 Credentials (Get from console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Dev Admin Master Key (Exclusive to developer; isolated from client/Super Admin)
DEV_ADMIN_KEY="genz_dev_master_2026"
