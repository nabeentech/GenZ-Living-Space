generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  googleId         String?   @unique
  name             String
  phone            String?
  role             String    @default("CUSTOMER") // SUPER_ADMIN, PROPERTY_MANAGER, RECEPTIONIST, FINANCE, HOUSEKEEPING, SUPPORT_STAFF, CUSTOMER
  avatarUrl        String?
  gender           String?   // MALE, FEMALE, OTHER
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?
  govtIdType       String?   // AADHAAR, PASSPORT, VOTER_ID
  govtIdNumber     String?
  aadhaarFrontImage String?
  aadhaarBackImage  String?
  hasVehicle       Boolean   @default(false)
  vehicleNumber    String?
  drivingLicenseNumber String?
  active           Boolean   @default(true)
  permissions      String?   @default("{}") // JSON string of granular access overrides
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings         Booking[]
  payments         Payment[]
  reviews          Review[]
  supportTickets   SupportTicket[]
  assignedTasks    HousekeepingTask[] @relation("AssignedHousekeeping")
  auditLogs        AuditLog[]
  homeTheaterBookings HomeTheaterBooking[]

  @@index([role, active])
  @@index([phone])
}

model Hostel {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  city         String
  state        String
  address      String
  postalCode   String
  latitude     Float?
  longitude    Float?
  description  String
  coverImage   String
  images       String   @default("[]") // JSON string of image URLs
  contactPhone String
  contactEmail String
  checkInTime  String   @default("13:00")
  checkOutTime String   @default("11:00")
  rating       Float    @default(4.8)
  rules        String   @default("[]") // JSON string of house rules
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  beds         Bed[]
  bookings     Booking[]
  invoices     Invoice[]
  reviews      Review[]
  tickets      SupportTicket[]
  tasks        HousekeepingTask[]
  amenities    HostelAmenity[]
  galleryImages GalleryImage[]
  expenses     Expense[]
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String   // Lucide icon name
  category    String   // COMMUNITY, ROOM, TECH, UTILITY, ENTERTAINMENT
  description String?

  hostels     HostelAmenity[]
}

model HostelAmenity {
  id        String  @id @default(cuid())
  hostelId  String
  amenityId String

  hostel    Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([hostelId, amenityId])
}

model RoomType {
  id                String   @id @default(cuid())
  name              String   // e.g. "Twin Sharing Pod Room", "Triple Sharing"
  slug              String   @unique
  description       String
  totalBeds         Int      @default(2)
  genderCategory    String   @default("MIXED") // MALE, FEMALE, MIXED, PRIVATE
  
  // Non-AC Pricing
  pricePerDayNonAC      Float?   // 1-day rate (Non-AC)
  price7DaysNonAC       Float?   // 7-day (1 week) rate (Non-AC)
  price10DaysNonAC      Float?   // 10-day rate (Non-AC)
  price15DaysNonAC      Float?   // 15-day rate (Non-AC)
  price30DaysNonAC      Float?   // 30-day (monthly) rate (Non-AC)
  
  // AC Pricing
  pricePerDayAC         Float?   // 1-day rate (AC)
  price7DaysAC          Float?   // 7-day (1 week) rate (AC)
  price10DaysAC         Float?   // 10-day rate (AC)
  price15DaysAC         Float?   // 15-day rate (AC)
  price30DaysAC         Float?   // 30-day (monthly) rate (AC)
  
  // Legacy/Fallback pricing
  basePrice         Float?    // Daily rate in INR (fallback)
  monthlyPrice      Float?    // Monthly rate in INR (fallback)
  weeklyDiscountPct Float    @default(10.0)
  securityDeposit   Float    @default(5000.0)
  maintenanceFee    Float    @default(2000.0)
  
  images            String   @default("[]") // JSON array
  amenities         String   @default("[]") // JSON array
  
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rooms             Room[]
}

model Room {
  id             String   @id @default(cuid())
  hostelId       String
  roomTypeId     String
  building       String   @default("Block A")
  floor          Int      @default(1)
  roomNumber     String   // e.g. "101", "204"
  capacity       Int      @default(4)
  genderCategory String   @default("MIXED")
  status         String   @default("ACTIVE") // ACTIVE, MAINTENANCE, BLOCKED
  isAC           Boolean  @default(false) // AC or Non-AC room
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hostel         Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomType       RoomType @relation(fields: [roomTypeId], references: [id])
  beds           Bed[]
  bookings       Booking[]
  tasks          HousekeepingTask[]

  @@index([hostelId, status])
  @@index([roomTypeId])
  @@index([floor])
}

model Bed {
  id                String   @id @default(cuid())
  roomId            String
  hostelId          String
  bedNumber         String   // e.g. "Bed A", "Pod 1"
  tier              String   @default("SINGLE") // SINGLE or DOUBLE occupancy capacity
  status            String   @default("AVAILABLE") // AVAILABLE, RESERVED, OCCUPIED, MAINTENANCE, CLEANING, BLOCKED
  currentOccupantId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hostel            Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  tasks             HousekeepingTask[]

  @@index([roomId, status])
  @@index([hostelId, status])
  @@index([status, active])
}

model Booking {
  id                 String    @id @default(cuid())
  bookingReference   String    @unique // e.g. "GZ-829104"
  customerId         String
  hostelId           String
  roomId             String
  bedId              String
  checkInDate        DateTime
  checkOutDate       DateTime
  stayType           String    @default("DAILY") // DAILY, WEEKLY, MONTHLY
  isOpenEnded        Boolean   @default(false)
  guestsCount        Int       @default(1)
  
  // Pricing breakdown
  baseAmount         Float
  extraGuestCharges  Float     @default(0.0)
  taxAmount          Float     // 12% GST
  serviceFee         Float     @default(0.0)
  paidMaintenanceFee Float     @default(0.0)
  securityDeposit    Float     @default(0.0)
  paidSecurityDeposit Float    @default(0.0)
  discountAmount     Float     @default(0.0)
  customDiscountAmount Float   @default(0.0)
  monthlyRentDiscountAmount Float @default(0.0)
  monthlyRentDiscountMonths Int @default(0)
  monthlyRentDiscountCyclesApplied Int @default(0)
  couponCode         String?
  totalAmount        Float
  paidAmount         Float     @default(0.0)
  balanceAmount      Float     @default(0.0)
  
  // Statuses
  bookingStatus      String    @default("CONFIRMED") // PENDING, PAYMENT_PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, REFUND_PENDING, REFUNDED, NO_SHOW
  paymentStatus      String    @default("PAID")      // PENDING, PAID, PARTIAL, REFUNDED, FAILED
  
  // Guest Details
  guestName          String
  guestEmail         String
  guestPhone         String
  guestGender        String?
  guestGovtId        String?
  guestDetails       String?   // JSON array with contact details for every walk-in guest
  
  // QR & Holds
  qrCodeData         String?   // Encoded check-in verification string
  specialRequests    String?
  internalNotes      String?
  holdExpiresAt      DateTime? // 15-minute lock for payment sessions
  
  // Operations
  checkInTime        DateTime?
  checkOutTime       DateTime?
  checkedInBy        String?
  checkedOutBy       String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer           User      @relation(fields: [customerId], references: [id])
  hostel             Hostel    @relation(fields: [hostelId], references: [id])
  room               Room      @relation(fields: [roomId], references: [id])
  bed                Bed       @relation(fields: [bedId], references: [id])
  payments           Payment[]
  refunds            Refund[]
  invoices           Invoice[]
  additionalCharges  AdditionalCharge[]
  review             Review?
  extensions         BookingExtension[]

  @@index([hostelId, bookingStatus])
  @@index([bedId, bookingStatus])
  @@index([customerId])
  @@index([checkInDate, checkOutDate])
  @@index([createdAt])
  @@index([stayType, bookingStatus])
  @@index([bookingStatus, checkOutDate])
  @@index([bookingStatus, balanceAmount])
}

model Payment {
  id                 String   @id @default(cuid())
  bookingId          String
  customerId         String
  amount             Float
  currency           String   @default("INR")
  gateway            String   @default("RAZORPAY") // RAZORPAY, CASH, UPI, CARD, BANK_TRANSFER
  gatewayPaymentId   String?  // rzp_pay_...
  gatewayOrderId     String?  // rzp_order_...
  gatewaySignature   String?
  status             String   @default("CAPTURED") // CREATED, PENDING, AUTHORIZED, CAPTURED, FAILED, REFUNDED, PARTIALLY_REFUNDED
  paymentMethod      String?  // upi, card, netbanking, cash
  metadata           String?  // JSON string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer           User     @relation(fields: [customerId], references: [id])
  refunds            Refund[]

  @@index([bookingId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Refund {
  id                 String    @id @default(cuid())
  bookingId          String
  paymentId          String?
  amount             Float
  reason             String
  status             String    @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PROCESSED
  processedBy        String?   // Admin username/id
  requestedAt        DateTime  @default(now())
  processedAt        DateTime?
  notes              String?

  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment            Payment?  @relation(fields: [paymentId], references: [id])
}

model Invoice {
  id                 String   @id @default(cuid())
  invoiceNumber      String   @unique // e.g. "INV-2026-0001"
  bookingId          String
  customerId         String
  hostelId           String
  issueDate          DateTime @default(now())
  dueDate            DateTime
  baseAmount         Float
  taxAmount          Float
  serviceFee         Float    @default(0.0)
  securityDeposit    Float    @default(0.0)
  paidSecurityDeposit Float   @default(0.0)
  discountAmount     Float    @default(0.0)
  customDiscountAmount Float  @default(0.0)
  monthlyRentDiscountAmount Float @default(0.0)
  totalAmount        Float
  paidAmount         Float
  balanceDue         Float    @default(0.0)
  status             String   @default("PAID") // PAID, PARTIAL, DUE, CANCELLED
  createdAt          DateTime @default(now())

  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hostel             Hostel   @relation(fields: [hostelId], references: [id])

  @@index([bookingId, status])
  @@index([dueDate, status])
  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  description        String
  discountType       String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue      Float
  minBookingAmount   Float     @default(0.0)
  maxDiscountAmount  Float?
  startDate          DateTime  @default(now())
  expiryDate         DateTime
  usageLimit         Int       @default(100)
  usedCount          Int       @default(0)
  applicableHostelId String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

model AdditionalCharge {
  id          String   @id @default(cuid())
  bookingId   String
  category    String   // LAUNDRY, FOOD, LOST_KEY, DAMAGE, LATE_CHECKOUT, OTHER
  description String
  amount      Float
  status      String   @default("PENDING") // PENDING, PAID
  addedBy     String
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique // e.g. "TKT-8291"
  customerId  String
  hostelId    String
  category    String   // ROOM, BED, MAINTENANCE, CLEANING, PAYMENT, STAFF, NOISE, WIFI, OTHER
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_CUSTOMER, RESOLVED, CLOSED
  subject     String
  description String
  staffReply  String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    User     @relation(fields: [customerId], references: [id])
  hostel      Hostel   @relation(fields: [hostelId], references: [id])

  @@index([hostelId, status])
  @@index([customerId])
}

model HousekeepingTask {
  id            String    @id @default(cuid())
  hostelId      String
  roomId        String
  bedId         String?
  taskType      String    @default("CLEANING") // CLEANING, INSPECTION, LINEN_CHANGE, DEEP_CLEAN
  status        String    @default("DIRTY")    // DIRTY, CLEANING, CLEAN, INSPECTED, MAINTENANCE
  assignedTo    String?
  scheduledDate DateTime  @default(now())
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hostel        Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bed           Bed?      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  assignee      User?     @relation("AssignedHousekeeping", fields: [assignedTo], references: [id])

  @@index([hostelId, status])
  @@index([bedId])
  @@index([roomId])
}

model BookingExtension {
  id                 String   @id @default(cuid())
  bookingId          String
  originalCheckOut   DateTime
  newCheckOut        DateTime
  additionalAmount   Float
  status             String   @default("REQUESTED") // REQUESTED, CONFIRMED, CANCELLED
  createdAt          DateTime @default(now())

  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id                 String   @id @default(cuid())
  hostelId           String
  bookingId          String   @unique
  customerId         String
  overallRating      Float
  cleanlinessRating  Float
  locationRating     Float
  staffRating        Float
  facilitiesRating   Float
  valueRating        Float
  title              String
  comment            String
  status             String   @default("APPROVED") // PENDING, APPROVED, HIDDEN
  staffResponse      String?
  createdAt          DateTime @default(now())

  hostel             Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer           User     @relation(fields: [customerId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  userName      String   @default("System")
  action        String   // e.g. "CHANGE_BED", "CHECK_IN", "PROCESS_REFUND"
  entity        String   // "Booking", "Bed", "Payment", etc.
  entityId      String
  previousValue String?  // JSON string
  newValue      String?  // JSON string
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model WebsiteContent {
  id          String   @id @default(cuid())
  sectionKey  String   @unique // e.g. "hero", "why_us", "faqs", "contact_info"
  contentJson String   // JSON string
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  hostelId    String?
  title       String
  description String?
  category    String   @default("COMMON_AREA") // ROOMS, COMMON_AREA, ROOFTOP, WORKSPACE, DINING, EVENTS, OTHER
  imageUrl    String?  // Direct URL (for external/fallback/seed images)
  imageData   Bytes?   // Binary image data stored directly in SQLite BLOB database
  mimeType    String   @default("image/jpeg")
  fileSize    Int?     // Size in bytes
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostel      Hostel?  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String   @id @default(cuid())
  hostelId       String?
  title          String
  category       String   // POWER_BILLS, WATER_BILLS, STAFF_SALARY, ELECTRIC_WORKS, PLUMBING_WORKS, DAILY_ESSENTIALS, INTERNET_WIFI, FOOD_KITCHEN, HOUSEKEEPING_LAUNDRY, PROPERTY_RENT, APPLIANCES_REPAIRS, OTHER
  amount         Float
  expenseDate    DateTime @default(now())
  paymentMode    String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CARD
  status         String   @default("PAID") // PAID, PENDING
  vendorName     String?
  vendorPhone    String?
  receiptImage   String?  // Compressed WebP data URL
  isRecurring    Boolean  @default(false)
  notes          String?
  recordedById   String?
  recordedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hostel         Hostel?  @relation(fields: [hostelId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([hostelId, expenseDate])
  @@index([category, expenseDate])
  @@index([status, expenseDate])
}

model HomeTheaterBooking {
  id               String   @id @default(cuid())
  bookingCode      String   @unique
  userId           String?
  bookingId        String?
  residentName     String
  residentPhone    String?
  roomBedLabel     String?
  slotDateKey      String   // YYYY-MM-DD in Asia/Kolkata
  slotKey          String   // MORNING, AFTERNOON, EVENING, NIGHT
  title            String?  // Movie / Match / Event
  guestCount       Int      @default(2)
  notes            String?
  status           String   @default("BOOKED") // BOOKED, COMPLETED, BLOCKED, CANCELLED
  bookedByRole     String   @default("RESIDENT") // RESIDENT, ADMIN
  bookedByName     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slotDateKey, slotKey])
  @@index([userId, slotDateKey])
  @@index([status, slotDateKey])
}

